# ─── MQTT topic identifiers ───────────────────────────────────────────────────
# Generated automatically on first run and saved here.
# Copy these into the tray client's Settings → Share Code field, or share the
# full share code printed in the console at startup.
# PROJECT_ID=
# SYSTEM_ID=

# ─── Database ─────────────────────────────────────────────────────────────────
# Absolute path to the SQLite DB written by ETLGreenTally.ps1
# Use forward slashes even on Windows.
DB_PATH=S:/PBIData/SLI/Baxley Data/baxley_green_tally_data.sqlite3

# ─── ETL pipeline folder paths ────────────────────────────────────────────────
# BASE_PATH is the shared root for all ETL folders below.
# The sub-path vars are relative to BASE_PATH (just the subfolder name).
BASE_PATH=C:\Temp
CSV_NEW_PATH=New
CSV_FINISHED_PATH=Finished
EXCEL_BASE_PATH=base
EXCEL_TOTAL_PATH=total
EXCEL_FINAL_PATH=Final
LOG_PATH=logs

# ─── Status thresholds ────────────────────────────────────────────────────────
# Hours since last DB record before the pipeline is considered stale
GREEN_THRESHOLD_HOURS=26

# ─── MQTT broker (Mosquitto) ──────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
# Plain MQTT port used by this server to publish
MQTT_BROKER_PORT=1883
# WebSocket port clients use to subscribe (Mosquitto listener config)
MQTT_WS_PORT=9001
# Leave blank if the broker has no authentication
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── Check schedule ───────────────────────────────────────────────────────────
# How often the checker runs (cron syntax, default every 10 minutes)
CHECK_CRON=*/10 * * * *

# ─── REST API ─────────────────────────────────────────────────────────────────
API_PORT=3847
# Set to a comma-separated list of allowed origins, or * to allow all
API_CORS_ORIGIN=*
# Optional — absolute path for the local history SQLite DB (auto-created)
# Defaults to data/history.db inside the baxley-status-api folder
# HISTORY_DB_PATH=
